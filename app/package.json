{
  "name": "@babelbook/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node esbuild.mjs && ng build --configuration production",
    "build:bundles": "node esbuild.mjs",
    "start": "npm run build && electron .",
    "test": "npm run test:node && npm run test:ui",
    "test:node": "cd .. && vitest run app/test",
    "test:ui": "ng test",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@babelbook/core": "*"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@jsverse/transloco": "^8.4.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.2.0",
    "electron": "^43.4.1",
    "esbuild": "^0.25.12",
    "jsdom": "^30.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
